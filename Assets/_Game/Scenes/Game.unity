        \uC2DC\uAC04\uC774 \uC5C6\uB2E4.\n\uBB38\uC5D0 \uAC78\uB9B0 \uC790\uBB3C\uC1E0\uB97C
        \uC5F4\uBA74\n\uBCF5\uB3C4\uB85C \uB098\uAC08 \uC218 \uC788\uB2E4.\n\uB2E8,
        \uBCF5\uB3C4\uC5D0\uB294 \uD63C\uC790\uAC00 \uC544\uB2C8\uB2E4.\n\uC18C\uB9AC\uB97C
        \uB0B4\uC9C0 \uB9C8\uB77C."
      objectReference: {fileID: 0}
