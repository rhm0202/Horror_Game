    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: date
      value: "\uB0A0\uC9DC \uBD88\uBA85"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: page
      value: p. 03
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: title
      value: "\uC720\uC11C"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: author
      value: K
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: content
      value: "\uC774 \uAE00\uC744 \uC77D\uB294\uB2E4\uBA74 \uB098\uB294 \uC774\uBBF8
        \uC8FD\uC5C8\uACA0\uC9C0.\n\uAE08\uACE0\uB97C \uC5F4\uC5B4\uC57C \uD55C\uB2E4.
        \uBC88\uD638\uB294 \uB0B4\uAC00 \uC774 \uAC74\uBB3C \uACF3\uACF3\uC5D0 \uD53C\uB85C
        \uB0A8\uACA8\uB480\uB2E4. \uD558\uC9C0\uB9CC \uB9E8\uB208\uC73C\uB85C\uB294
        \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4.\n\uC190\uC804\uB4F1\uC758 \uBE5B\uC744
        \uBC14\uAFD4\uB77C. \uC790\uC678\uC120 \uC544\uB798\uC11C\uB9CC \uB4DC\uB7EC\uB09C\uB2E4.\n\uC21C\uC11C\uB300\uB85C
        \uCC3E\uC544\uB77C. #\uC73C\uB85C \uBE44\uBC00\uBC88\uD638\uB97C \uCD08\uAE30\uD654
        \uD560 \uC218 \uC788\uB2E4.\n\uC21C\uC11C\uB294 \uB2E4\uC74C\uC7A5\uC5D0
        \uC801\uC5B4\uB480\uB2E4.\n\uADF8\uAC83\uC774 \uC624\uACE0 \uC788\uB2E4.
        \uC11C\uB458\uB7EC\uB77C.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: content2
      value: "\uCCAB \uBC88\uC9F8 \u2014 \uB124\uAC00 \uCC98\uC74C \uB208\uC744 \uB72C
        \uBC29\n\uB450 \uBC88\uC9F8 \u2014 \uBCF5\uB3C4 \uBD81\uCABD \uBCBD\n\uC138
        \uBC88\uC9F8 \u2014 \uCC3D\uACE0 \uBB38 \uC606\n\uB124 \uBC88\uC9F8 \u2014
        \uCC3D\uACE0 \uAE08\uACE0 \uC606\n\uB2E4\uC12F \uBC88\uC9F8 \u2014 \uD720\uCCB4\uC5B4
        \uC704\n\uC5EC\uC12F \uBC88\uC9F8 \u2014 \uBCF4\uAD00\uD568 \uBB38 \uC606\n\uC22B\uC790\uB97C
        \uC21C\uC11C\uB300\uB85C \uC870\uD569\uD558\uBA74 \uAE08\uACE0\uAC00 \uC5F4\uB9B0\uB2E4.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8527493338337543914, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: m_Name
      value: Journal_02-1
      objectReference: {fileID: 0}
