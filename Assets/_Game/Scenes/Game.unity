    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: date
      value: "\uB0A0\uC9DC \uBD88\uBA85"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: title
      value: "\uBE44\uC0C1 \uD0C8\uCD9C \uC808\uCC28"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: author
      value: "\uC548\uC120\uC601"
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: content
      value: "\uC804\uB825\uC774 \uCC28\uB2E8\uB410\uB2E4. \uB0B4 \uC2E4\uC218\uB2E4.\n\uBCF5\uB3C4
        \uB05D \uCD9C\uC785\uAD6C\uB294 \uC804\uC790 \uC7A0\uAE08\uC774\uB2E4. \uC804\uB825
        \uC5C6\uC774\uB294 \uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uBC30\uC120\uD568\uC744
        \uCC3E\uC544\uB77C. \uC774 \uBC29 \uC5B4\uB518\uAC00\uC5D0 \uC788\uB2E4.\n\uBC30\uC120\uD568\uC744
        \uC5F4\uB824\uBA74 \uC138 \uAC00\uC9C0\uAC00 \uD544\uC694\uD558\uB2E4.\n\uB0B4\uAC00
        \uCC98\uC74C \uC788\uB358 \uBC29\uC5D0 \uB450\uACE0 \uC628 \uAC83, \uB450
        \uBC88\uC9F8 \uBC29\uC5D0\uC11C \uAC00\uC838\uC628 \uAC83, \uADF8\uB9AC\uACE0
        \uC774 \uBC29 \uC548\uC5D0 \uC788\uB294 \uAC83.\n\uC14B\uC744 \uBAA8\uC544
        \uBC30\uC120\uD568\uC5D0 \uC5F0\uACB0\uD558\uBA74 \uC804\uB825\uC774 \uB3CC\uC544\uC628\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7496530954250695419, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: content2
      value: "\uC804\uB825\uC774 \uBCF5\uAD6C\uB418\uBA74 \uCD9C\uC785\uAD6C \uC7A0\uAE08\uC774
        \uD574\uC81C\uB41C\uB2E4. \uD558\uC9C0\uB9CC \uBB38\uC5D0\uB294 \uBCC4\uB3C4
        \uBE44\uBC00\uBC88\uD638\uAC00 \uAC78\uB824\uC788\uB2E4.\n\uBC88\uD638\uB294
        \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4. \uADF8\uB0A0\uC744 \uC78A\uC744 \uC218
        \uC5C6\uC73C\uB2C8\uAE4C.\n\uBAA8\uB4E0 \uAC83\uC774 \uBB34\uB108\uC9C4 \uB0A0.
        08\uC6D4 10\uC77C.\n\uC81C\uBC1C \uC0B4\uC544\uC11C \uB098\uAC00\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 8527493338337543914, guid: 26ecf415bcce8094c9da15a9b3c850bd, type: 3}
      propertyPath: m_Name
      value: Journal_03
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
